# AI Video Assistant - Environment Configuration

# Mistral AI API Key (For summarization, extraction, and RAG Q&A)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Optional: for Hinglish / Indian language transcription & translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Local Whisper Model size (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Sarvam STT Model
SARVAM_STT_MODEL=saaras:v2.5
